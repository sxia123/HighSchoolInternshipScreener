# Leave TURSO_* blank to use local SQLite at DATABASE_PATH (zero setup needed)
DATABASE_PATH=data/internships.db

# Optional: Turso (libSQL) for production / GitHub Actions sync
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: Protect POST /api/scan if deployed publicly (leave blank for local dev)
# SCAN_TRIGGER_SECRET=change-me

# Optional: CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
